# ==============================================================================
# ParkPulse Server Environment Variables
# ==============================================================================

# Server Port (Render/Railway automatically supplies PORT)
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# Allowed Client Origins for Credentialed CORS (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# Secret for Signing JWT Session Cookies (use strong random string in production)
JWT_SECRET=parkpulse_super_secret_jwt_key_change_in_production_2026

# Cookie SameSite setting ('lax' for same-site, 'none' for cross-site HTTPS deployment)
COOKIE_SAME_SITE=lax

# PostgreSQL Database Connection URL (Leave blank to use built-in SQLite)
# Example: postgresql://postgres:password@localhost:5432/parkpulse
DATABASE_URL=

# Demo Mode ('true' enables GPS simulation and demo accounts, 'false' for strict production)
DEMO_MODE=true
