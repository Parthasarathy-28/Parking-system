# ==============================================================================
# ParkPulse Client Environment Variables
# ==============================================================================

# Backend API Base URL (Leave blank in local development to use Vite proxy)
# In production on Vercel: set to your deployed backend (e.g. https://parkpulse-api.onrender.com)
VITE_API_URL=

# Socket.IO WebSocket Gateway URL (Defaults to VITE_API_URL or current host)
VITE_SOCKET_URL=
